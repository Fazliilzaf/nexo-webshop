{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "brand": "NEXO",
    "version": "1.0.0",
    "note": "Source of truth for the NEXO webshop. Derived from the physical packaging: matte black label, griege wordmark, thin letterspaced type, zero ornament."
  },
  "color": {
    "brand": {
      "griege":       { "value": "#A8A09D", "note": "THE brand colour. From NEXO-färg-hex.jpg. Never alter." },
      "griegeLight":  { "value": "#C9C3C0" },
      "griegeDark":   { "value": "#6E6764", "note": "AA-safe griege for text on bone/white (4.98:1)" },
      "black":        { "value": "#0A0908", "note": "Label black. Site canvas." },
      "ink":          { "value": "#151312", "note": "Raised surface on black" },
      "bone":         { "value": "#F5F2F0", "note": "Paper mode for long-form reading" },
      "boneDeep":     { "value": "#E8E3DF" },
      "white":        { "value": "#FFFFFF" }
    },
    "semantic": {
      "dark": {
        "bg":        { "value": "{color.brand.black}" },
        "surface":   { "value": "{color.brand.ink}" },
        "text":      { "value": "#EDEAE8" },
        "textMuted": { "value": "{color.brand.griege}" },
        "border":    { "value": "rgba(168,160,157,0.22)" },
        "accent":    { "value": "{color.brand.griege}" }
      },
      "light": {
        "bg":        { "value": "{color.brand.bone}" },
        "surface":   { "value": "{color.brand.white}" },
        "text":      { "value": "{color.brand.black}" },
        "textMuted": { "value": "{color.brand.griegeDark}" },
        "border":    { "value": "rgba(10,9,8,0.14)" },
        "accent":    { "value": "{color.brand.griegeDark}" }
      },
      "state": {
        "success": { "value": "#5C6B5E" },
        "error":   { "value": "#8C4A3F" },
        "focus":   { "value": "{color.brand.griege}" }
      }
    }
  },
  "font": {
    "family": {
      "display": { "value": "\"Buda Light\", \"Buda\", Georgia, serif", "note": "Brand voice. Headlines and wordmark ONLY. Never below 28px." },
      "body":    { "value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif" },
      "mono":    { "value": "\"SF Mono\", ui-monospace, Menlo, monospace", "note": "Order numbers, INCI lists" }
    },
    "weight": { "light": { "value": 300 }, "regular": { "value": 400 }, "medium": { "value": 500 } },
    "size": {
      "display1": { "value": "clamp(3.5rem, 11vw, 9rem)" },
      "display2": { "value": "clamp(2.75rem, 7vw, 5.5rem)" },
      "h1":       { "value": "clamp(2rem, 4.5vw, 3.25rem)" },
      "h2":       { "value": "clamp(1.5rem, 3vw, 2.25rem)" },
      "h3":       { "value": "clamp(1.125rem, 2vw, 1.5rem)" },
      "body":     { "value": "1rem" },
      "bodyLg":   { "value": "1.125rem" },
      "small":    { "value": "0.8125rem" },
      "eyebrow":  { "value": "0.6875rem" }
    },
    "tracking": {
      "display": { "value": "0.02em" },
      "eyebrow": { "value": "0.18em", "note": "Uppercase micro-labels — the packaging signature" },
      "button":  { "value": "0.12em" },
      "body":    { "value": "0" }
    },
    "leading": { "tight": { "value": 1.05 }, "snug": { "value": 1.2 }, "normal": { "value": 1.6 }, "relaxed": { "value": 1.75 } }
  },
  "space": {
    "1": { "value": "4px" }, "2": { "value": "8px" }, "3": { "value": "12px" }, "4": { "value": "16px" },
    "5": { "value": "24px" }, "6": { "value": "32px" }, "7": { "value": "48px" }, "8": { "value": "64px" },
    "9": { "value": "96px" }, "10": { "value": "128px" }, "11": { "value": "160px" }, "12": { "value": "200px" }
  },
  "layout": {
    "maxWidth":     { "value": "1440px" },
    "readWidth":    { "value": "68ch" },
    "gutterMobile": { "value": "20px" },
    "gutterDesktop":{ "value": "40px" },
    "columns":      { "value": 12 },
    "headerHeight": { "value": "64px" }
  },
  "radius":  { "none": { "value": "0" }, "sm": { "value": "2px" }, "pill": { "value": "999px" } },
  "border":  { "hairline": { "value": "1px" } },
  "motion": {
    "duration": { "fast": { "value": "160ms" }, "base": { "value": "320ms" }, "slow": { "value": "560ms" }, "reveal": { "value": "800ms" } },
    "easing":   { "out": { "value": "cubic-bezier(0.16, 1, 0.3, 1)" }, "inOut": { "value": "cubic-bezier(0.65, 0, 0.35, 1)" } }
  },
  "breakpoint": { "sm": { "value": "480px" }, "md": { "value": "768px" }, "lg": { "value": "1024px" }, "xl": { "value": "1280px" }, "xxl": { "value": "1536px" } },
  "zIndex": { "base": { "value": 0 }, "sticky": { "value": 100 }, "header": { "value": 200 }, "drawer": { "value": 300 }, "modal": { "value": 400 }, "toast": { "value": 500 } }
}
