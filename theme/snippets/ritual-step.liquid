{%- comment -%}
  One step of the ritual. Rendered three times by ritual-experience.
  Params: key (one|two|three), handle, material, n (1|2|3), preload
{%- endcomment -%}
{%- assign product = all_products[handle] -%}
{%- assign base = 'ritual.steps.' | append: key -%}

<article
  class="ritual__step"
  data-step="{{ n }}"
  aria-label="{{ 'ritual.step_label' | t: step: n }}"
>
  <div class="ritual__material" aria-hidden="true">
    {%- assign mat_base = material | remove: '.jpg' -%}
    <picture>
      <source media="(min-width: 1024px)" srcset="{{ mat_base | append: '-desktop.jpg' | asset_url }}">
      <img
        src="{{ mat_base | append: '-mobile.jpg' | asset_url }}"
        alt=""
        width="1440"
        height="2122"
        {%- if preload %} fetchpriority="high"{% else %} loading="lazy"{% endif -%}
      >
    </picture>
  </div>
  <div class="ritual__veil" aria-hidden="true"></div>

  <div class="ritual__body">
    <h2 class="ritual__name t-display">
      <span class="ritual__name-line">{{ base | append: '.name_line_1' | t }}</span>
      <span class="ritual__name-line">
        {{- base | append: '.name_line_2' | t -}}
        <span class="step-mark">{{ base | append: '.step' | t }}</span>
      </span>
    </h2>

    <div class="ritual__info glass glass--press">
      <span class="glass__caustic" aria-hidden="true"></span>

      <div class="ritual__info-top t-mono">
        <span class="t-griege">
          {{- base | append: '.index' | t }} / {{ base | append: '.verb' | t -}}
        </span>
        <span class="t-ghost">{{ base | append: '.category' | t }}</span>
      </div>

      <p class="ritual__tagline">{{ base | append: '.tagline' | t }}</p>

      <div class="ritual__info-row t-mono">
        <span>{{ base | append: '.volume' | t }}</span>
        <span class="ritual__price">
          {%- if product -%}
            {%- assign price_number = product.price | plus: 0 -%}
            {%- if price_number > 0 -%}
              {{ product.price | money }}
            {%- else -%}
              <span aria-hidden="true">0,00 kr</span>
              <span class="dev-badge">{{ 'general.price.tbd' | t }}</span>
              <span class="visually-hidden">{{ 'general.price.tbd_note' | t }}</span>
            {%- endif -%}
          {%- else -%}
            <span aria-hidden="true">0,00 kr</span>
            <span class="dev-badge">{{ 'general.price.tbd' | t }}</span>
            <span class="visually-hidden">{{ 'general.price.tbd_note' | t }}</span>
          {%- endif -%}
        </span>
      </div>

      <a class="ritual__inci t-mono" href="#ingredients">
        {{- base | append: '.ingredients_count' | t }} ·
        {{ base | append: '.ingredients_cta' | t }} →
      </a>

      {%- if product and product.selected_or_first_available_variant -%}
        <button
          type="button"
          class="btn ritual__add"
          data-add
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
        >
          {{ 'ritual.add' | t }}
        </button>
      {%- else -%}
        <button type="button" class="btn ritual__add" data-add disabled>
          {{ 'ritual.add' | t }}
        </button>
      {%- endif -%}
    </div>
  </div>
</article>
