<section
  class="ritual ritual--static"
  id="ritual"
  data-ritual
  aria-label="{{ 'ritual.progress_label' | t }}"
>
  <div class="ritual__track" data-ritual-track>
    <div class="ritual__stage">

      {%- render 'ritual-step',
        key: 'one',
        handle: 'lather-me-up',
        material: 'material-lather.jpg',
        n: 1,
        preload: true
      -%}
      {%- render 'ritual-step',
        key: 'two',
        handle: 'mist-me-crazy',
        material: 'material-mist.jpg',
        n: 2,
        preload: false
      -%}
      {%- render 'ritual-step',
        key: 'three',
        handle: 'whip-me-good',
        material: 'material-whip.jpg',
        n: 3,
        preload: false
      -%}

      <ol class="ritual__rail glass" data-ritual-rail>
        <span class="glass__caustic" aria-hidden="true"></span>
        {%- for i in (1..3) -%}
          <li data-rail-step="{{ i }}">
            <span class="t-mono">+{{ i }}</span>
            <span class="ritual__rail-dot" aria-hidden="true"></span>
          </li>
        {%- endfor -%}
      </ol>

      <div class="ritual__sweep" data-ritual-sweep aria-hidden="true"></div>

      <p class="ritual__begin t-mono" data-ritual-begin aria-hidden="true">
        {{ 'ritual.begin' | t }} <span class="ritual__begin-arrow">→</span>
      </p>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ritual experience",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Ritual experience" }]
}
{% endschema %}
