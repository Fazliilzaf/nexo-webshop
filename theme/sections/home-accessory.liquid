{%- comment -%}
  Homepage accessory strip — the brush. Lives outside the +1/+2/+3 core:
  no step numbering, no ritual language, flat griege surface (no glass).
{%- endcomment -%}
{%- assign brush = all_products['borste'] -%}

<section class="home-acc" id="tillbehor">
  <div class="home-acc__inner">
    <div class="home-acc__media" aria-hidden="true">
      <img
        src="{{ 'pdp-brush.jpg' | asset_url }}"
        alt=""
        width="1400"
        height="933"
        loading="lazy"
      >
    </div>

    <div class="home-acc__body">
      <p class="t-mono home-acc__kicker">{{ 'pdp.accessory_kicker' | t }}</p>
      <h2 class="home-acc__name t-display">{{ 'accessory.name' | t }}</h2>

      <div class="home-acc__row t-mono">
        {%- if brush -%}
          {%- assign brush_price = brush.price | plus: 0 -%}
          {%- if brush_price > 0 -%}
            <span class="home-acc__price">{{ brush.price | money }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="home-acc__actions">
        {%- if brush and brush.selected_or_first_available_variant -%}
          <button
            type="button"
            class="btn home-acc__add"
            data-add
            data-variant-id="{{ brush.selected_or_first_available_variant.id }}"
          >
            {{ 'ritual.add' | t }}
          </button>
        {%- endif -%}
        <a class="home-acc__link t-mono" href="/products/borste">
          {{ 'accessory.view' | t }} →
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home accessory",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Home accessory" }]
}
{% endschema %}
